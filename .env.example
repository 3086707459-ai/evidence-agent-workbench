# Export these variables in your shell; this file is not loaded automatically.
# Demo mode needs no API key.
AGENT_DB=data/agent.db
AGENT_CORPUS=corpus
AGENT_BIND=127.0.0.1
AGENT_PORT=8090
# Required when binding outside loopback; also usable on localhost.
AGENT_API_TOKEN=
# Optional separate approval credential; required for non-loopback serving.
AGENT_APPROVAL_TOKEN=
# Real model mode requires both; choose a Responses function-calling capable model.
OPENAI_API_KEY=
OPENAI_MODEL=
